# Copy this file to .env and fill in real values before production.
# Nothing here is required to run the demo (it works with the sample site
# and no API keys) -- but nothing here should be skipped before launch.

# ---------------------------------------------------------------------
# Crawl source
# ---------------------------------------------------------------------
# "local" = read data/sample_site (demo/dev). "http" = crawl your real site.
CRAWL_MODE=local
SITE_LOCAL_DIR=data/sample_site
SITE_SITEMAP_URL=https://biddabari.com/sitemap.xml
SITE_BASE_URL=https://biddabari.com

# ---------------------------------------------------------------------
# Embeddings -- pick ONE provider
# ---------------------------------------------------------------------
# "local"  : sentence-transformers, free, offline, decent Bangla (default)
# "openai" : best quality, needs OPENAI_API_KEY
# "cohere" : strong multilingual, needs COHERE_API_KEY
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
COHERE_API_KEY=

# ---------------------------------------------------------------------
# Vector store
# ---------------------------------------------------------------------
# "local" = JSON file on disk (fine up to tens of thousands of chunks)
# "qdrant" = real Qdrant instance
VECTOR_STORE_BACKEND=local
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=biddabari_chunks

TOP_K=5
MIN_RELEVANCE_SCORE=0.28

# ---------------------------------------------------------------------
# LLM (answer generation) -- REQUIRED for real answers
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_MAX_TOKENS=600

# ---------------------------------------------------------------------
# API behaviour
# ---------------------------------------------------------------------
RATE_LIMIT_PER_HOUR=30
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_THRESHOLD=0.95
